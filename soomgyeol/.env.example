# 서버 포트와 공개 주소 (공유 이미지·사이트맵에 쓰입니다)
PORT=3000
PUBLIC_URL=http://localhost:3000
# 데이터베이스 파일 위치
DB_PATH=./data/soomgyeol.db
# 이 이메일로 가입하면 관리자 권한이 부여됩니다
ADMIN_EMAIL=
# https 배포 시 1 (쿠키 Secure)
COOKIE_SECURE=0
# 결제 모드: test 만 구현되어 있습니다. live 는 결제사 연결 후 사용
BILLING_MODE=test
# 결제 알림(웹훅) 서명 검증용 비밀값. 운영에서는 반드시 긴 임의 값으로 교체
WEBHOOK_SECRET=change-me
