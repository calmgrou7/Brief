# 비워두면 샘플 데이터로 실행됩니다.
# 메타 비즈니스 관리자 > 시스템 사용자에서 발급한 토큰 (ads_read 권한)
META_ACCESS_TOKEN=
# 선택: Graph API 버전 고정
META_API_VERSION=v24.0

# 고객 리포트 링크 서명용 비밀값 (16자 이상, 아무도 모르게). 바꾸면 기존 링크가 모두 무효가 됩니다.
# 예: openssl rand -base64 32
REPORT_SECRET=

# 운영자 로그인 비밀번호 (8자 이상). 운영 서버에서 비워두면 운영자 화면이 잠깁니다.
OWNER_PASSWORD=

# 선택: Supabase 저장소. 비워두면 .data/ 폴더의 파일에 저장합니다.
# Supabase 대시보드 > Connect > Transaction pooler 연결 문자열 (비밀번호 포함)
DATABASE_URL=
