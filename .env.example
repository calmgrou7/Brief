# ── 기본 ─────────────────────────────
PORT=3000
APP_NAME=기업지원사업
DB_PATH=data/app.db

# 관리자 페이지(/admin) 로그인 토큰 — 길고 랜덤하게 (예: openssl rand -hex 24)
ADMIN_TOKEN=change-me-to-a-long-random-string

# 운영자(정책지원마스터) 정보 — 신청 완료 화면·개인정보처리방침에 표시
OPERATOR_NAME=정책지원마스터
OPERATOR_PHONE=010-0000-0000
OPERATOR_EMAIL=chaeumpartners07@gmail.com

# ── 기업마당 지원사업 API (없으면 mock 데이터로 동작) ──
# 발급: https://www.bizinfo.go.kr > 정책정보 개방 > API 신청
BIZINFO_API_KEY=

# ── 웹푸시 (npm run vapid 로 생성) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:chaeumpartners07@gmail.com

# 주간 알림 스케줄 (KST, cron 형식). 기본: 매주 월 09:00
ENABLE_CRON=true
WEEKLY_CRON=0 9 * * 1

# ── 신규 신청 자동화 웹훅 (Zapier / Make / n8n / Slack Incoming Webhook 등) ──
# 신청이 들어오면 JSON 으로 POST → 구글시트 적재, 카톡/문자 알림, CRM 등록 자동화
LEAD_WEBHOOK_URL=

# ── 개인정보 ──
PRIVACY_POLICY_VERSION=2026-11-v1
LEAD_RETENTION_DAYS=1095
