# ───────── 서비스 기본 ─────────
NEXT_PUBLIC_SITE_NAME=보담체크
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 상담을 실제로 진행하는 주체(설계사/GA명). 동의서·개인정보처리방침에 표시됩니다.
NEXT_PUBLIC_OPERATOR_NAME=(상호명 입력)
# 제3자 제공 대상(제휴 설계사/GA). 비워두면 제3자 제공 동의 항목이 숨겨집니다.
NEXT_PUBLIC_THIRD_PARTY_RECIPIENTS=

# ───────── DB (Supabase) ─────────
# 비워두면 개발용 로컬 파일(.data/)에 저장합니다. 운영에서는 반드시 설정하세요.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ───────── AI 상담 (Claude) ─────────
# 비워두면 내장 FAQ 규칙 기반 답변으로 동작합니다.
ANTHROPIC_API_KEY=
# 기본값 claude-opus-5-5. 비용을 줄이려면 claude-haiku-5-5 등으로 변경 가능.
CLAUDE_MODEL=claude-opus-5-5

# ───────── 휴대폰 인증 (SOLAPI) ─────────
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
# 인증번호 서명용 비밀값 (길고 랜덤하게)
OTP_SECRET=change-me-to-a-long-random-string
# true면 SMS 대신 화면에 인증번호를 보여줍니다 (개발용, 운영 금지)
OTP_DEV_MODE=true

# ───────── 자동화 ─────────
# 리드 접수 시 JSON POST (Zapier/Make/n8n 웹훅 → 구글시트·알림톡·슬랙)
LEAD_WEBHOOK_URL=

# ───────── 관리자 ─────────
ADMIN_PASSWORD=change-me

# ───────── 3단계: 구글플레이 앱 (TWA) ─────────
ANDROID_PACKAGE=
# Play Console > 앱 무결성 > 앱 서명 키 SHA-256 (여러 개면 쉼표)
ANDROID_SHA256=
