# ===== 거래소 =====
# 테스트넷 키는 https://testnet.bybit.com 에서 발급 (실계정 키와 다릅니다)
BYBIT_API_KEY=
BYBIT_API_SECRET=
# true = 테스트넷(가짜 돈). 실거래는 false + 아래 확인 문구 필요
BYBIT_TESTNET=true
LIVE_TRADING_CONFIRM=

SYMBOL=BTC/USDT:USDT
TIMEFRAME=15m
LEVERAGE=3

# ===== 전략: EMA 교차 + RSI 필터, ATR 기반 손절/익절 =====
EMA_FAST=20
EMA_SLOW=50
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
ATR_PERIOD=14
SL_ATR_MULT=1.5
TP_ATR_MULT=3.0

# ===== 리스크 =====
# 1회 거래 손절 시 잃는 금액 = 잔고의 1%
RISK_PER_TRADE=0.01
# 하루(KST) 잔고가 5% 줄면 포지션 정리 후 그날 거래 중지
MAX_DAILY_LOSS=0.05
# 포지션 증거금 상한 = 잔고의 90%
MAX_POSITION_PCT=0.9

# ===== 실행 =====
POLL_SECONDS=20

# ===== 텔레그램 알림 (선택) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
