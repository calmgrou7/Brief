# 비워두면 해당 단계는 데모(예시 결과)로 동작해요.

# AssemblyAI 받아쓰기 – https://www.assemblyai.com 대시보드에서 발급
ASSEMBLYAI_API_KEY=
# (선택) 모델 지정. 비우면 AssemblyAI 기본 모델
ASSEMBLYAI_SPEECH_MODEL=
# (선택) 자주 쓰는 고유명사 – 쉼표로 구분
WORD_BOOST=중진공,소진공,정책자금,기보,신보,스마트스토어

# Claude 정리 – https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=
# (선택) 모델 변경. 기본 claude-opus-5-5
CLAUDE_MODEL=

# Notion 저장 – https://www.notion.so/my-integrations 에서 내부 통합 생성 후 토큰 복사
NOTION_TOKEN=
# 상담기록 DB 주소의 32자리 ID (🎙️ 미팅 음성메모 상담기록)
NOTION_DATABASE_ID=fcec98f5f1e84e7184261efe659f9905

# (권장) 공개 주소로 배포할 때 접속 코드
APP_PASSCODE=
