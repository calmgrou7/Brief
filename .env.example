# ===== 거래소 =====
# lighter (탈중앙 선물, 한국 제한 없음, 수수료 0) 또는 bybit (한국 거주자 이용 불가)
EXCHANGE=lighter
# true = 테스트넷(가짜 돈). 실거래는 false + 아래 확인 문구 필요
TESTNET=true
LIVE_TRADING_CONFIRM=

# --- Lighter: testnet.app.lighter.xyz 에서 발급 (지갑 개인키/시드 문구는 절대 넣지 마세요) ---
LIGHTER_ACCOUNT_INDEX=
# 4 이상 254 이하
LIGHTER_API_KEY_INDEX=
LIGHTER_API_PRIVATE_KEY=
# 비워두면 서명 라이브러리를 자동으로 내려받습니다
LIGHTER_SIGNER_PATH=

# --- Bybit (EXCHANGE=bybit 일 때만) ---
BYBIT_API_KEY=
BYBIT_API_SECRET=

# 비워두면 lighter=BTC/USDC:USDC, bybit=BTC/USDT:USDT
SYMBOL=
TIMEFRAME=15m
LEVERAGE=3

# ===== 전략: EMA 교차 + RSI 필터, ATR 기반 손절/익절 =====
EMA_FAST=20
EMA_SLOW=50
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
ATR_PERIOD=14
SL_ATR_MULT=1.5
TP_ATR_MULT=3.0
# 필터 (0 = 끔). TREND_EMA=200: 장기 추세 방향으로만 진입 / ADX_MIN=25: 추세가 약하면 진입 안 함
TREND_EMA=0
ADX_PERIOD=14
ADX_MIN=0

# ===== 리스크 =====
# 1회 거래 손절 시 잃는 금액 = 잔고의 1%
RISK_PER_TRADE=0.01
# 하루(KST) 잔고가 5% 줄면 포지션 정리 후 그날 거래 중지
MAX_DAILY_LOSS=0.05
# 포지션 증거금 상한 = 잔고의 90%
MAX_POSITION_PCT=0.9

# ===== 실행 =====
POLL_SECONDS=20

# ===== 텔레그램 알림 (선택) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
