# 서비스마다 같은 형식. 비워 두면 그 서비스는 예시 데이터로 자리만 보입니다.
#   _APP_URL      : 그 서비스 대시보드 주소 ('열기' 버튼)
#   _SUMMARY_URL  : 요약 JSON 주소 (형식은 README '요약 규격')
#   _SUMMARY_TOKEN: 요약 주소가 토큰을 요구할 때만
#   _EMBED_URL    : 상세 탭 안에 그 대시보드를 그대로 띄우고 싶을 때만

VITE_CHAEUM_APP_URL=
VITE_CHAEUM_SUMMARY_URL=
VITE_CHAEUM_SUMMARY_TOKEN=
VITE_CHAEUM_EMBED_URL=

VITE_WIDLY_APP_URL=
VITE_WIDLY_SUMMARY_URL=
VITE_WIDLY_SUMMARY_TOKEN=
VITE_WIDLY_EMBED_URL=
