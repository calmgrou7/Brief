<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>관리자 로그인 | <%= site.company_name %></title>
<link rel="stylesheet" href="<%= base %>/static/pretendard/pretendardvariable-dynamic-subset.css">
<link rel="stylesheet" href="<%= base %>/static/css/admin.css">
</head>
<body>
<div class="login">
  <form method="post" action="<%= base %>/admin/login">
    <h1><%= site.company_name %> 관리자</h1>
    <% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>
    <div class="f"><label for="username">아이디</label><input id="username" name="username" type="text" autocomplete="username" required autofocus></div>
    <div class="f"><label for="password">비밀번호</label><input id="password" name="password" type="password" autocomplete="current-password" required></div>
    <button class="btn btn--primary" type="submit" style="width:100%">로그인</button>
  </form>
</div>
</body>
</html>
