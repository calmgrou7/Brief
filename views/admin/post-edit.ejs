<%- include('_head') %>
<div class="top"><h1><%= post.id ? '글 수정' : '새 글' %> <span class="help"><%= BOARDS[post.board].name %></span></h1>
  <div class="actions">
    <% if (post.id && post.published) { %><a class="btn" href="<%= base %>/board/<%= post.board %>/<%= post.id %>" target="_blank" rel="noopener">사이트에서 보기</a><% } %>
    <a class="btn" href="<%= base %>/admin/posts">목록</a>
  </div>
</div>
<% if (typeof error !== 'undefined' && error) { %><p class="alert" role="alert"><%= error %></p><% } %>
<form method="post" action="<%= base %>/admin/posts/save">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <input type="hidden" name="id" value="<%= post.id || '' %>">
  <input type="hidden" name="board" value="<%= post.board %>">
  <div class="cols">
    <div>
      <div class="f"><label for="title">제목</label><input id="title" name="title" type="text" value="<%= post.title %>" required></div>
      <div class="f">
        <label for="body"><%= post.board === 'qna' ? '문의 내용' : '본문' %></label>
        <textarea id="body" name="body" rows="18" required><%= post.body %></textarea>
        <p class="hint">빈 줄로 문단을 나눕니다. <code>## 소제목</code>, <code>- 목록</code>, <code>**굵게**</code>를 쓸 수 있습니다.</p>
      </div>
      <% if (post.board === 'qna') { %>
        <div class="f">
          <label for="answer">답변</label>
          <textarea id="answer" name="answer" rows="10" placeholder="답변을 저장하면 글 아래에 표시됩니다."><%= post.answer || '' %></textarea>
          <% if (post.answered_at) { %><p class="hint">마지막 답변: <%= post.answered_at %></p><% } %>
        </div>
      <% } %>
    </div>
    <div>
      <div class="box">
        <div class="f"><label for="author">작성자</label><input id="author" name="author" type="text" value="<%= post.author %>"></div>
        <div class="inline">
          <label><input type="checkbox" name="published" value="1" <%= post.published ? 'checked' : '' %>> 공개</label>
          <label><input type="checkbox" name="is_pinned" value="1" <%= post.is_pinned ? 'checked' : '' %>> 위에 고정</label>
        </div>
        <% if (post.board === 'qna') { %><p class="help" style="margin-top:var(--space-sm)"><%= post.is_secret ? '작성자가 비밀글로 남긴 문의입니다.' : '공개 문의입니다.' %></p><% } %>
        <p style="margin-top:var(--space-lg)"><button class="btn btn--primary" type="submit">저장</button></p>
      </div>
    </div>
  </div>
</form>
<% if (post.id) { %>
<form method="post" action="<%= base %>/admin/posts/<%= post.id %>/delete" onsubmit="return confirm('이 글을 지울까요? 되돌릴 수 없습니다.')" style="margin-top:var(--space-lg)">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <button class="btn btn--danger" type="submit">글 삭제</button>
</form>
<% } %>
<%- include('_foot') %>
