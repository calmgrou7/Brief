<%- include('../partials/head') %>
<section class="notice-done">
  <div class="container narrow">
    <h1>비밀글입니다</h1>
    <p class="lead">작성할 때 정한 비밀번호를 넣으시면 글과 답변을 보실 수 있습니다.</p>
    <form class="form" method="post" action="<%= base %>/board/<%= board %>/<%= post.id %>/unlock" style="margin-top:var(--space-xl);max-width:480px">
      <% if (error) { %><p class="form-alert" role="alert"><%= error %></p><% } %>
      <div class="field">
        <label for="password">비밀번호</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>
      </div>
      <div class="form__submit"><a href="<%= base %>/board/<%= board %>">목록으로</a><button class="btn btn--primary" type="submit">열기</button></div>
    </form>
  </div>
</section>
<%- include('../partials/foot') %>
